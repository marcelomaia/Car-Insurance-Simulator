# Copy to `.env` and adjust. Loaded by `infrastructure.config.settings.Settings` (prefix `CAR_INSURANCE_`).
# Omit a variable to keep the built-in default (see readme / execution plan).

# Base policy coverage factor (1 = 100% of car value).
CAR_INSURANCE_BASE_COVERAGE_PERCENTAGE=1

# Additive rate per year of vehicle age (0.005 = 0.5%).
CAR_INSURANCE_RATE_PER_AGE_YEAR=0.005

# Additive rate per value chunk (0.005 = 0.5% per chunk below).
CAR_INSURANCE_RATE_PER_VALUE_CHUNK=0.005

# Value chunk size in currency units (e.g. dollars).
CAR_INSURANCE_VALUE_CHUNK_SIZE=10000
